# Copia este archivo a ".env" y completa los valores. ".env" nunca se versiona.

# Neon > Connect > "Pooled connection": el host termina en "-pooler".
# Lo usa la aplicación en tiempo de ejecución.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon > Connect > "Direct connection" (sin pooler).
# Lo usan las migraciones y la CLI de Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Credenciales de la persona dueña que crea el seed (elige una contraseña propia).
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me"
